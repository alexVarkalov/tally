# From @BotFather
BOT_TOKEN=

# Required: path to the Google service-account JSON key. Share the spreadsheet with the service account's
# e-mail (Editor). Keep the file out of git (data/ and *service-account*.json are gitignored) and deploy it
# out-of-band, like .env. The file must exist at startup.
GOOGLE_SERVICE_ACCOUNT_FILE=data/service-account.json

# Required: the spreadsheet ID, the long token in the sheet URL between /d/ and /edit.
# One worksheet per tracker; worksheets are created by /new or attached by /attach.
GOOGLE_SPREADSHEET_ID=

# PostgreSQL connection (SQLAlchemy URL). Holds the users table and the tracker registry only; the recorded
# rows live in Google Sheets.
DATABASE_URL=postgresql+psycopg://tally:tally@localhost:5432/tally

# Comma/semicolon-separated Telegram user IDs with admin rights (/users, /allow_user, /block_user).
# Admins always have access themselves; put the owner's ID here. Get your ID from @userinfobot.
ADMIN_USER_IDS=

# IANA timezone for users who have not set one with /timezone. "Today" and the date buttons use it.
DEFAULT_TIMEZONE=Europe/Warsaw

# Number of date buttons offered when recording (today and the days before it), clamped to 1..7.
DAY_CHOICES=3
